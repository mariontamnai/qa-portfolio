    {
      "name": "Student Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login successful\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Token is returned\", function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response.token).to.exist;",
              "});",
              "",
              "pm.test(\"Student name is returned\", function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response.fullName).to.exist;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"regNumber\": \"sct121-0517/2024\",\n  \"password\": \"MillWhite!12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
