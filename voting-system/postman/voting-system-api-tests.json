    {
      "name": "Student Login-Invalid Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login fails with wrong password\", function() {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Error message is returned\", function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response.message).to.equal(\"Invalid credentials\");",
              "});"
